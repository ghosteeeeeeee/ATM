[Unit]
Description=Hermes Shadow Disposition Timer — daily Mon 08:15 UTC (after 07:15 daily commit)

[Timer]
# brain_auditor 2026-10-27 run #190: was Mon-only. The registry's own contract is
# day-scale — 8 of 13 open entries carry 2026-11-03 deadlines and every packet
# promises a 24h CEO clock — so a weekly runner could only honor them by firing
# the default ~6 days after the deadline (Mon 08:15 runs: Nov 2 warns, Nov 9 acts).
# Daily keeps the same 08:15 slot; state dedupe means packets still issue once.
# REVERT 2026-11-03 brain_auditor #218: 11-03 cluster dispositioned
# (ugb KEEP / midband NO-CHANGE / esc-17 stale-close / watch-contrarian EXTEND /
# cadence entry falsely claimed EXECUTED while files stayed daily — fixed now).
OnCalendar=*-*-* 08:15:00
# 2026-11-04 re-daily (CEO hail-mary verdict 20261104T161050Z + registered default of
# timer-cadence-recheck): weekly could not honor the 11-05/06/07 reads incl. the 11-07
# fold-line; reverse of disposition-cadence-revert, re-evaluate when calendar is sparse
Persistent=true

[Install]
WantedBy=timers.target
