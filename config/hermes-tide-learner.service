[Unit]
Description=Hermes Tide Auto-Learner — learns new signal patterns daily
After=network.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/root/.hermes/scripts
ExecStart=/usr/bin/python3 /root/.hermes/scripts/tide_auto_learner.py
StandardOutput=journal
StandardError=journal
TimeoutStartSec=300
