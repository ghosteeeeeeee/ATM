[Unit]
Description=Hermes Health Monitor — deterministic disk/price/timer/phantom checks
# CEO 2026-10-27 item 3: replaced the hourly LLM agent (~$4.10/30d) with
# scripts/health_monitor.py. The old agent re-read `systemctl is-active` / `df -h`
# output that this script checks directly, and mostly reported "system healthy".
# pipeline_watchdog.py (2 min) still owns lock/heartbeat/signal/trade/service
# restarts; this owns disk, price staleness, data-feed timer liveness, phantom
# trades, log compression, and the anomaly-only error_alerts.md writer.
[Service]
EnvironmentFile=/root/.hermes/.env
Type=oneshot
WorkingDirectory=/root/.hermes
ExecStart=/usr/bin/python3 /root/.hermes/scripts/health_monitor.py
TimeoutStartSec=300
